        "valid = []\n",
        "invalid = []\n",
        "other_city = []\n",
        "\n",
        "with open(\"customer.csv\", \"r\", newline=\"\") as f:\n",
        "    reader = csv.DictReader(f)\n",
        "\n",
        "    for row in reader:\n",
        "      name = row[\"name\"].strip()\n",
        "      age_str = row[\"age\"].strip() # Renamed to avoid confusion before conversion\n",
        "      city = row[\"city\"].strip().lower()\n",
        "\n",
        "      # Handle empty name, age, or city first\n",
        "      if name == \"\" or city == \"\":\n",
        "        invalid.append(row)\n",
        "        continue\n",
        "\n",
        "      if age_str == \"\": # Check for empty age string\n",
        "        invalid.append(row)\n",
        "        continue\n",
        "\n",
        "      try:\n",
        "        age = int(age_str)\n",
        "      except ValueError:\n",
        "        invalid.append(row) # If age is not a valid integer, it's invalid\n",
        "        continue\n",
        "\n",
        "      # Now apply the filtering logic based on processed data\n",
        "      if age >= 18 and city == \"hyderabad\":\n",
        "        valid.append(row)\n",
        "      elif age < 18: # If age is less than 18, mark as invalid\n",
        "        invalid.append(row)\n",
        "      else: # If age is 18+ but city is not hyderabad\n",
        "        other_city.append(row)\n",
        "\n",
        "# Print results after the loop has finished processing all rows\n",
