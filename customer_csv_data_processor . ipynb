        "import csv\n",
        "import json\n",
        "\n",
        "data = [\n",
        "    {\"name\": \"John\", \"age\": 30, \"city\": \"New York\"},\n",
        "    {\"name\": \"Jane\", \"age\": 25, \"city\": \"London\"},\n",
        "    {\"name\": \"Bob\", \"age\": 35, \"city\": \"Paris\"},\n",
        "    {\"name\": \"Alice\", \"age\": 32, \"city\": \"hyderabad\"},\n",
