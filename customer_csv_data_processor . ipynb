        "]\n",
        "\n",
        "with open(\"people.csv\", \"w\", newline=\"\") as f:\n",
        "    writer = csv.DictWriter(f, fieldnames=[\"name\", \"age\", \"city\"])\n",
        "    writer.writeheader()\n",
        "    writer.writerows(data)\n",
        "\n",
        "with open (\"people.csv\", \"r\", newline=\"\") as f:\n",
        "  reader = csv.DictReader(f)\n",
        "  customers = list(reader)\n",
        "\n",
        "  selected_customers = []\n",
        "\n",
        "  for customer in customers:\n",
        "    if int(customer[\"age\"]) >= 30 and (customer[\"city\"] == \"hyderabad\" or \\\n",
        "                                      customer[\"city\"] == \"mumbai\"):\n",
        "      selected_customers.append(customer)\n",
        "\n",
        "  with open(\"selected_customers.json\",\"w\") as f:\n",
        "    json.dump(selected_customers,f, indent=4)\n",
        "\n",
        "  with open(\"selected_customers.json\", \"r\") as f:\n",
        "    result = json.load(f)\n",
        "    print(\"csv -- python -- JSON conversion completed!\")\n",
